  "definitions": {
    "votes_first": "votes_resolved: the first count",
    "votes_final": "the resolved final count (highest-ranked source, then the most-corroborated); AV and STV contests only; blank for a candidate eliminated before the final count",
    "share_first": "votes_first / sum of votes_first within the contest (share of votes cast, not of electors)",
    "share_final": "votes_final / sum of votes_final over the candidates still in at the final count; AV contests only, with at least two such candidates including the winner; never for STV",
    "margin": "share of the m-th candidate minus the (m+1)-th, m = magnitude; on the final count where share_final exists",
    "magnitude": "count of elected candidates in the contest",
    "formula": "from review/electoral_systems/nonplurality_contests.csv (AV/STV split by magnitude); else block when magnitude > 1, else FPTP",
    "turnout_pct": "100 * votes_total / electorate, contested FPTP contests only",
    "quality": "A corroborated and clean; B single-source or resolved by rule; C incomplete or disputed; D winner or totals in doubt",
    "person_key": "internal grouping by normalized name within a province; regenerated every build; not exposed",
    "source_use": "which source supplied each resolved data point per province-election and field: party = party_resolved_source, votes = votes_resolved_source, winner = win_resolved_source else the first source agreeing with win_resolved, eligible = table1 eligible_source, name = preferred_source else the first source listing the candidate; dq = the source's most common dq among its rows for that election",
    "tier": "major: won the largest caucus (ties included) in some election of some province; minor: otherwise won 2+ seats or 5 %+ of first-count votes cast in some province-election; residual: the rest, and always none / other / Independent; review/atlas/party_families.csv tier column overrides"
  },
